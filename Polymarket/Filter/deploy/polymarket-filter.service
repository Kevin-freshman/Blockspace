[Unit]
Description=Blockspace Polymarket Crypto Filter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/kevin/Blockspace/Polymarket/Filter
ExecStart=/usr/bin/python3 /home/ubuntu/kevin/Blockspace/Polymarket/Filter/app.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
